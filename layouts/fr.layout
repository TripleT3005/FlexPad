# FlexPad keyboard layout: French (fr)
# Generated by Claude (AI), not reviewed yet.
# Please report mistakes as an issue: https://github.com/TripleT3005/FlexPad/issues
# Reviewed by: -
#
# Format: see LAYOUTS.md. Key positions use the names of a US keyboard (KeyboardEvent.code).
# Labels: position = printed label. Characters: character = keys, e.g. @ = AltGr+KeyQ or é = dead:Equal KeyE.
# Uppercase letters, space, Enter and Tab need no line of their own. Write # as U+0023.

layout.name = French

# Labels

AltRight = AltGr
KeyQ = A
KeyW = Z
KeyA = Q
KeyZ = W
Semicolon = M
KeyM = ,
Minus = )
Equal = =
BracketLeft = ^
BracketRight = $
Backslash = *
Quote = Ù
Backquote = ²
Comma = ;
Period = :
Slash = !
IntlBackslash = <

# Letters

a = KeyQ
b = KeyB
c = KeyC
d = KeyD
e = KeyE
f = KeyF
g = KeyG
h = KeyH
i = KeyI
j = KeyJ
k = KeyK
l = KeyL
m = Semicolon
n = KeyN
o = KeyO
p = KeyP
q = KeyA
r = KeyR
s = KeyS
t = KeyT
u = KeyU
v = KeyV
w = KeyZ
x = KeyX
y = KeyY
z = KeyW
é = Digit2
è = Digit7
ç = Digit9
à = Digit0
ù = Quote

# Digits and symbols

1 = Shift+Digit1
2 = Shift+Digit2
3 = Shift+Digit3
4 = Shift+Digit4
5 = Shift+Digit5
6 = Shift+Digit6
7 = Shift+Digit7
8 = Shift+Digit8
9 = Shift+Digit9
0 = Shift+Digit0
² = Backquote
& = Digit1
" = Digit3
' = Digit4
( = Digit5
- = Digit6
_ = Digit8
U+0023 = AltGr+Digit3
{ = AltGr+Digit4
[ = AltGr+Digit5
| = AltGr+Digit6
\ = AltGr+Digit8
^ = AltGr+Digit9
@ = AltGr+Digit0
) = Minus
° = Shift+Minus
] = AltGr+Minus
= = Equal
+ = Shift+Equal
} = AltGr+Equal
$ = BracketRight
£ = Shift+BracketRight
¤ = AltGr+BracketRight
% = Shift+Quote
* = IntlHash
µ = Shift+IntlHash
< = IntlBackslash
> = Shift+IntlBackslash
, = KeyM
? = Shift+KeyM
; = Comma
. = Shift+Comma
: = Period
/ = Shift+Period
! = Slash
§ = Shift+Slash
€ = AltGr+KeyE

# Dead keys

~ = dead:AltGr+Digit2 Space
` = dead:AltGr+Digit7 Space
¨ = dead:Shift+BracketLeft Space
â = dead:BracketLeft KeyQ
ê = dead:BracketLeft KeyE
î = dead:BracketLeft KeyI
ô = dead:BracketLeft KeyO
û = dead:BracketLeft KeyU
ä = dead:Shift+BracketLeft KeyQ
ë = dead:Shift+BracketLeft KeyE
ï = dead:Shift+BracketLeft KeyI
ö = dead:Shift+BracketLeft KeyO
ü = dead:Shift+BracketLeft KeyU
ÿ = dead:Shift+BracketLeft KeyY
À = dead:AltGr+Digit7 Shift+KeyQ
È = dead:AltGr+Digit7 Shift+KeyE
ì = dead:AltGr+Digit7 KeyI
ò = dead:AltGr+Digit7 KeyO
Ù = dead:AltGr+Digit7 Shift+KeyU
ñ = dead:AltGr+Digit2 KeyN
