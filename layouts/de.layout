# FlexPad keyboard layout: German (de)
# Generated by Claude (AI), not reviewed yet.
# Please report mistakes as an issue: https://github.com/TripleT3005/FlexPad/issues
# Reviewed by: -
#
# Format: see LAYOUTS.md. Key positions use the names of a US keyboard (KeyboardEvent.code).
# Labels: position = printed label. Characters: character = keys, e.g. @ = AltGr+KeyQ or é = dead:Equal KeyE.
# Uppercase letters, space, Enter and Tab need no line of their own. Write # as U+0023.

layout.name = German

# Labels

AltRight = AltGr
KeyY = Z
KeyZ = Y
Minus = ß
Equal = ´
BracketLeft = Ü
BracketRight = +
Backslash = #
Semicolon = Ö
Quote = Ä
Backquote = ^
Comma = ,
Period = .
Slash = -
IntlBackslash = <
NumpadDecimal = ,

# Letters

a = KeyA
b = KeyB
c = KeyC
d = KeyD
e = KeyE
f = KeyF
g = KeyG
h = KeyH
i = KeyI
j = KeyJ
k = KeyK
l = KeyL
m = KeyM
n = KeyN
o = KeyO
p = KeyP
q = KeyQ
r = KeyR
s = KeyS
t = KeyT
u = KeyU
v = KeyV
w = KeyW
x = KeyX
y = KeyZ
z = KeyY
ä = Quote
ö = Semicolon
ü = BracketLeft
ß = Minus

# Digits and symbols

1 = Digit1
2 = Digit2
3 = Digit3
4 = Digit4
5 = Digit5
6 = Digit6
7 = Digit7
8 = Digit8
9 = Digit9
0 = Digit0
! = Shift+Digit1
" = Shift+Digit2
§ = Shift+Digit3
$ = Shift+Digit4
% = Shift+Digit5
& = Shift+Digit6
/ = Shift+Digit7
( = Shift+Digit8
) = Shift+Digit9
= = Shift+Digit0
² = AltGr+Digit2
³ = AltGr+Digit3
{ = AltGr+Digit7
[ = AltGr+Digit8
] = AltGr+Digit9
} = AltGr+Digit0
? = Shift+Minus
\ = AltGr+Minus
+ = BracketRight
* = Shift+BracketRight
~ = AltGr+BracketRight
U+0023 = IntlHash
' = Shift+IntlHash
° = Shift+Backquote
, = Comma
; = Shift+Comma
. = Period
: = Shift+Period
- = Slash
_ = Shift+Slash
< = IntlBackslash
> = Shift+IntlBackslash
| = AltGr+IntlBackslash
@ = AltGr+KeyQ
€ = AltGr+KeyE
µ = AltGr+KeyM

# Dead keys

^ = dead:Backquote Space
´ = dead:Equal Space
` = dead:Shift+Equal Space
â = dead:Backquote KeyA
ê = dead:Backquote KeyE
î = dead:Backquote KeyI
ô = dead:Backquote KeyO
û = dead:Backquote KeyU
á = dead:Equal KeyA
é = dead:Equal KeyE
í = dead:Equal KeyI
ó = dead:Equal KeyO
ú = dead:Equal KeyU
à = dead:Shift+Equal KeyA
è = dead:Shift+Equal KeyE
ì = dead:Shift+Equal KeyI
ò = dead:Shift+Equal KeyO
ù = dead:Shift+Equal KeyU
