# FlexPad keyboard layout: English (UK) (en-GB)
# Generated by Claude (AI), not reviewed yet.
# Please report mistakes as an issue: https://github.com/TripleT3005/FlexPad/issues
# Reviewed by: -
#
# Format: see LAYOUTS.md. Key positions use the names of a US keyboard (KeyboardEvent.code).
# Labels: position = printed label. Characters: character = keys, e.g. @ = AltGr+KeyQ or é = dead:Equal KeyE.
# Uppercase letters, space, Enter and Tab need no line of their own. Write # as U+0023.

layout.name = English (UK)

# Labels

AltRight = AltGr
Minus = -
Equal = =
BracketLeft = [
BracketRight = ]
Backslash = #
Semicolon = ;
Quote = '
Backquote = `
Comma = ,
Period = .
Slash = /
IntlBackslash = \

# Letters

a = KeyA
b = KeyB
c = KeyC
d = KeyD
e = KeyE
f = KeyF
g = KeyG
h = KeyH
i = KeyI
j = KeyJ
k = KeyK
l = KeyL
m = KeyM
n = KeyN
o = KeyO
p = KeyP
q = KeyQ
r = KeyR
s = KeyS
t = KeyT
u = KeyU
v = KeyV
w = KeyW
x = KeyX
y = KeyY
z = KeyZ
á = AltGr+KeyA
é = AltGr+KeyE
í = AltGr+KeyI
ó = AltGr+KeyO
ú = AltGr+KeyU
Á = Shift+AltGr+KeyA
É = Shift+AltGr+KeyE
Í = Shift+AltGr+KeyI
Ó = Shift+AltGr+KeyO
Ú = Shift+AltGr+KeyU

# Digits and symbols

1 = Digit1
2 = Digit2
3 = Digit3
4 = Digit4
5 = Digit5
6 = Digit6
7 = Digit7
8 = Digit8
9 = Digit9
0 = Digit0
` = Backquote
¬ = Shift+Backquote
¦ = AltGr+Backquote
! = Shift+Digit1
" = Shift+Digit2
£ = Shift+Digit3
$ = Shift+Digit4
€ = AltGr+Digit4
% = Shift+Digit5
^ = Shift+Digit6
& = Shift+Digit7
* = Shift+Digit8
( = Shift+Digit9
) = Shift+Digit0
- = Minus
_ = Shift+Minus
= = Equal
+ = Shift+Equal
[ = BracketLeft
{ = Shift+BracketLeft
] = BracketRight
} = Shift+BracketRight
; = Semicolon
: = Shift+Semicolon
' = Quote
@ = Shift+Quote
U+0023 = IntlHash
~ = Shift+IntlHash
\ = IntlBackslash
| = Shift+IntlBackslash
, = Comma
< = Shift+Comma
. = Period
> = Shift+Period
/ = Slash
? = Shift+Slash
