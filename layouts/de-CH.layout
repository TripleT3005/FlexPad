# FlexPad keyboard layout: German (Switzerland) (de-CH)
# Generated by Claude (AI), not reviewed yet.
# Please report mistakes as an issue: https://github.com/TripleT3005/FlexPad/issues
# Reviewed by: -
#
# Format: see LAYOUTS.md. Key positions use the names of a US keyboard (KeyboardEvent.code).
# Labels: position = printed label. Characters: character = keys, e.g. @ = AltGr+KeyQ or é = dead:Equal KeyE.
# Uppercase letters, space, Enter and Tab need no line of their own. Write # as U+0023.

layout.name = German (Switzerland)

# Labels

AltRight = AltGr
KeyY = Z
KeyZ = Y
Minus = '
Equal = ^
BracketLeft = Ü
BracketRight = ¨
Backslash = $
Semicolon = Ö
Quote = Ä
Backquote = §
Comma = ,
Period = .
Slash = -
IntlBackslash = <

# Letters

a = KeyA
b = KeyB
c = KeyC
d = KeyD
e = KeyE
f = KeyF
g = KeyG
h = KeyH
i = KeyI
j = KeyJ
k = KeyK
l = KeyL
m = KeyM
n = KeyN
o = KeyO
p = KeyP
q = KeyQ
r = KeyR
s = KeyS
t = KeyT
u = KeyU
v = KeyV
w = KeyW
x = KeyX
y = KeyZ
z = KeyY
ü = BracketLeft
è = Shift+BracketLeft
ö = Semicolon
é = Shift+Semicolon
ä = Quote
à = Shift+Quote
ç = Shift+Digit4

# Digits and symbols

1 = Digit1
2 = Digit2
3 = Digit3
4 = Digit4
5 = Digit5
6 = Digit6
7 = Digit7
8 = Digit8
9 = Digit9
0 = Digit0
§ = Backquote
° = Shift+Backquote
+ = Shift+Digit1
" = Shift+Digit2
* = Shift+Digit3
% = Shift+Digit5
& = Shift+Digit6
/ = Shift+Digit7
( = Shift+Digit8
) = Shift+Digit9
= = Shift+Digit0
¦ = AltGr+Digit1
@ = AltGr+Digit2
U+0023 = AltGr+Digit3
¬ = AltGr+Digit6
| = AltGr+Digit7
¢ = AltGr+Digit8
' = Minus
? = Shift+Minus
! = Shift+BracketRight
[ = AltGr+BracketLeft
] = AltGr+BracketRight
{ = AltGr+Quote
$ = IntlHash
£ = Shift+IntlHash
} = AltGr+IntlHash
, = Comma
; = Shift+Comma
. = Period
: = Shift+Period
- = Slash
_ = Shift+Slash
< = IntlBackslash
> = Shift+IntlBackslash
\ = AltGr+IntlBackslash
€ = AltGr+KeyE

# Dead keys

^ = dead:Equal Space
` = dead:Shift+Equal Space
~ = dead:AltGr+Equal Space
´ = dead:AltGr+Minus Space
¨ = dead:BracketRight Space
â = dead:Equal KeyA
ê = dead:Equal KeyE
î = dead:Equal KeyI
ô = dead:Equal KeyO
û = dead:Equal KeyU
À = dead:Shift+Equal Shift+KeyA
È = dead:Shift+Equal Shift+KeyE
ì = dead:Shift+Equal KeyI
ò = dead:Shift+Equal KeyO
ù = dead:Shift+Equal KeyU
á = dead:AltGr+Minus KeyA
É = dead:AltGr+Minus Shift+KeyE
í = dead:AltGr+Minus KeyI
ó = dead:AltGr+Minus KeyO
ú = dead:AltGr+Minus KeyU
ñ = dead:AltGr+Equal KeyN
Ä = dead:BracketRight Shift+KeyA
ë = dead:BracketRight KeyE
ï = dead:BracketRight KeyI
Ö = dead:BracketRight Shift+KeyO
Ü = dead:BracketRight Shift+KeyU
